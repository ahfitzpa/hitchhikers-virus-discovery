# Explicit targets: nothing else requests them now that annotate takes the
# score as params.
def _virsorter2_skipped():
    """Samples excluded from VIRSORTER_TARGETS, from configs/virsorter2_skip_samples.txt.

    VirSorter2 is an annotation, not a gate: annotate_viral_positives takes the
    score as a params path and the merge writes NA when it is missing, so a
    skipped sample still produces taxonomy_merged.tsv. Measured across the 191
    completed Hepeviridae samples, VirSorter2 is the sole evidence for zero
    contigs -- collect_viral_positives builds the candidate set from
    Kraken2/geNomad/RdRpCATCH and VirSorter2 is joined on afterwards -- so
    skipping a sample cannot lose a viral call.
    """
    p = "configs/virsorter2_skip_samples.txt"
    out = set()
    if not os.path.exists(p):
        return out
    with open(p) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            sid = line.split("\t")[0].strip()
            if sid and sid != "sample_id":
                out.add(sid)
    return out


VIRSORTER2_SKIP = _virsorter2_skipped()
if VIRSORTER2_SKIP:
    print(f"[phase2] VirSorter2 skipped for {len(VIRSORTER2_SKIP)} sample(s): "
          f"{', '.join(sorted(VIRSORTER2_SKIP))}", file=sys.stderr)

# Explicit targets: nothing else requests them now that annotate takes the
# score as params. Samples in the skip list are left out -- each exhausted all
# three attempts at runtime=900 because its assembly carries 1.7-4.7M contigs
# against a 147k median, which VirSorter2 cannot process in the wall clock.
VIRSORTER_TARGETS = [
    target
    for fam in FAMILIES
    for target in expand(
        "data/03.rnaviralSPAdes/{family}/{sample}/virsorter2/final-viral-score.tsv",
        family=[fam],
        sample=[s for s in family_samples(fam) if s not in VIRSORTER2_SKIP],
    )
]

